# Plantilla de configuración local (NO contiene la key).
# Copiá este archivo a `.env` y pegá tu key de IonQ:
#   cp front/qards/.env.example front/qards/.env
#   # editar front/qards/.env  ->  IONQ_API_KEY=tu_key
#
# `.env` está gitignored: la key NUNCA se commitea ni se sube al browser.
# El dev-server también acepta `--env <ruta>` o la variable de entorno IONQ_API_KEY.
IONQ_API_KEY=
